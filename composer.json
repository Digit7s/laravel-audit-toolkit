{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "digit7s/laravel-audit-toolkit",
    "description": "A Laravel-native, privacy-conscious audit event recorder and read API.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Digit7s"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/console": "^13.0",
        "illuminate/auth": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Digit7s\\AuditToolkit\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Digit7s\\AuditToolkit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest --compact tests/Feature",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "benchmark": "pest --compact tests/Performance"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Digit7s\\AuditToolkit\\AuditServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
